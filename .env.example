# Development example
DJANGO_DEBUG=true

# Replace this value before any real deployment.
DJANGO_SECRET_KEY=development-only-change-me

# Comma-separated hostnames without http:// or https://
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated full origins when deploying the browser form.
# Example:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://literature-lab.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional SQLite location.
# The default is literature_lab/db.sqlite3.
# Docker will use /data/db.sqlite3.
# DJANGO_DATABASE_PATH=/absolute/path/to/db.sqlite3
